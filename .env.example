# Copy to .env and fill in. .env is gitignored and must stay that way.
#
#   set -a; . ./.env; set +a
#   uv run uvicorn bounded_mandate.web:app --host 0.0.0.0 --port 8117

# --- the model (Layer 2 and the buyer agent) -------------------------------
# Free key from https://build.nvidia.com. Without it the policy compiler still
# works — it falls back to a deterministic parse and says so on the card.
NVIDIA_API_KEY=nvapi-...
# BM_LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
# BM_LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# --- settlement ------------------------------------------------------------
# Dashboard → Account & Settings → API Keys. Test mode is enough.
# The secret never leaves the server process; the app never sees either value.
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=
RAZORPAY_MANDATE_METHOD=upi
# RAZORPAY_WEBHOOK_SECRET=

# --- voice (optional) ------------------------------------------------------
# Hearing is always ElevenLabs Scribe; speaking is either service.
# `elevenlabs` or `rumik` — swap to record the demo with whichever sounds right.
BM_TTS_PROVIDER=elevenlabs

# ElevenLabs → API Keys. Use the key itself, which starts with `sk_`, not the
# key ID shown beside it. Required for transcription whichever voice speaks.
# Unset, the app is text-only and says so; it never silently loses a decision
# because audio failed.
ELEVENLABS_API_KEY=sk_...

# Rumik Silk — Indian-English TTS, 24 kHz wav. Speaking only; it does not
# transcribe, so it never replaces the key above.
RUMIK_API_KEY=rk_live_...
# `mulberry` steers with a description and a preset speaker; `muga` with tone
# tags and neither of those fields.
# RUMIK_MODEL=mulberry
# RUMIK_SPEAKER=siya
# RUMIK_DESCRIPTION=calm, clear, reassuring Indian English
# Must be a *premade* voice on a free tier — library voices 402.
# `curl https://api.elevenlabs.io/v1/voices -H "xi-api-key: $ELEVENLABS_API_KEY"`
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# ELEVENLABS_STT_MODEL=scribe_v2

# --- commerce --------------------------------------------------------------
# `mock` (default) is three simulated shops, offline and deterministic. `swiggy`
# is real Instamart, read and cart-assembly only — it can never place an order.
# BM_COMMERCE=swiggy

# Swiggy issues no API keys. Run the OAuth flow (phone + OTP in a browser) and
# paste the access token here. It lasts five days; `refresh_token` is advertised
# but not wired in v1.0, so renewal is a person, not a cron.
# SWIGGY_ACCESS_TOKEN=...
# `search_products` needs an addressId from `get_addresses`, and serviceability
# varies by address — pin the demo one rather than discovering it on camera.
# SWIGGY_ADDRESS_ID=...
# The docs give /food and /dineout but never spell out the Instamart path.
# SWIGGY_MCP_URL=https://mcp.swiggy.com/im

# --- scheduling ------------------------------------------------------------
# Lists with a cadence go out on their own when this is 1. Off by default: a
# background task that runs an agent should not start itself on a laptop.
# It cannot widen anything — the engine decides exactly as it would for a
# proposal a human triggered.
# BM_SCHEDULER=1
# BM_SCHEDULER_TICK=20

# --- storage ---------------------------------------------------------------
# BM_LEDGER=ledger.jsonl
