# Copy to .env and fill in. .env is gitignored and must stay that way.
#
#   set -a; . ./.env; set +a
#   uv run uvicorn bounded_mandate.web:app --host 0.0.0.0 --port 8117

# --- the model (Layer 2 and the buyer agent) -------------------------------
# Free key from https://build.nvidia.com. Without it the policy compiler still
# works — it falls back to a deterministic parse and says so on the card.
NVIDIA_API_KEY=nvapi-...
# BM_LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
# BM_LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# --- settlement ------------------------------------------------------------
# Dashboard → Account & Settings → API Keys. Test mode is enough.
# The secret never leaves the server process; the app never sees either value.
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=
RAZORPAY_MANDATE_METHOD=upi
# RAZORPAY_WEBHOOK_SECRET=

# --- voice (optional) ------------------------------------------------------
# ElevenLabs → API Keys. Use the key itself, which starts with `sk_`, not the
# key ID shown beside it. Unset, the app is text-only and says so; it never
# silently loses a decision because audio failed.
ELEVENLABS_API_KEY=sk_...
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# ELEVENLABS_STT_MODEL=scribe_v2

# --- storage ---------------------------------------------------------------
# BM_LEDGER=ledger.jsonl
